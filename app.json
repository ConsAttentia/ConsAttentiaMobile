{
  "expo": {
    "name": "ConsattentiaMob",
    "slug": "ConsattentiaMob",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/consattentia-app-icon.png",
    "scheme": "consattentiamob",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/consattentia-app-icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "package": "com.anonymous.ConsattentiaMob"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/consattentia-logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/AtkinsonHyperlegible-Regular.ttf",
            "./assets/fonts/AtkinsonHyperlegible-Bold.ttf"
          ],
          "android": {
            "fonts": [
              {
                "fontFamily": "Atkinson Hyperlegible",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/AtkinsonHyperlegible-Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./assets/fonts/AtkinsonHyperlegible-Bold.ttf",
                    "weight": 700
                  }
                ]
              }
            ]
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Permita que o ConsAttentia encontre psicologos proximos de voce."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      "expo-sharing",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
