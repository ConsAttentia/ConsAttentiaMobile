{
  "expo": {
    "name": "ConsattentiaMob",
    "slug": "ConsattentiaMob",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/consattentia-logo.png",
    "scheme": "consattentiamob",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/consattentia-logo.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/consattentia-logo.png"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
